{
	"name": "rion-git",
	"version": "1.0.1",
	"description": "轻量版 Obsidian Git 插件：自动备份、推送与拉取",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"git"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.0",
		"obsidian": "^1.7.0",
		"typescript": "^5.7.0"
	}
}
